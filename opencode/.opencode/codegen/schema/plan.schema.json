{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencode.local/codegen/plan.schema.json",
  "title": "OpenCode Code Generation Plan",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "objective",
    "base_revision",
    "phases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "base_revision": {
      "type": "string",
      "minLength": 1
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "phase_id",
          "objective",
          "depends_on",
          "contracts"
        ],
        "properties": {
          "phase_id": {
            "type": "string",
            "minLength": 1
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "contracts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/contract"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "final_verification": {
      "type": "object",
      "required": [
        "commands"
      ],
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "description": "One requirement of the contract. Its id is referenced by the checks that verify it.",
      "required": [
        "id",
        "statement"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique within the contract, for example R1."
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "change",
            "preserve"
          ],
          "default": "change",
          "description": "change: the requirement adds or alters behavior, so its checks must fail on the untouched baseline. preserve: the requirement keeps existing behavior, so its checks must already pass on the baseline. A check that already passed before the change proves nothing about a change requirement."
        },
        "verification": {
          "enum": [
            "automated",
            "manual"
          ],
          "default": "automated",
          "description": "automated: at least one check verifies it. manual: no check can verify it; it is reported as pending human verification. A contract needs at least one automated requirement, otherwise it has no Gate."
        },
        "covers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": [],
          "description": "Ids of Goal requirements and acceptance criteria this requirement satisfies. Every Goal requirement with priority must and every acceptance criterion with verification_type automated must be covered by some contract requirement (automated ones for automated criteria)."
        }
      },
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "description": "One executable check of the Gate. The orchestrator materializes it as .codegen-contract/checks/<id>.sh; the generated gate.sh runs every check.",
      "required": [
        "id",
        "covers",
        "command"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique within the contract, for example C1."
        },
        "covers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Ids of the contract requirements this check verifies. Its expected baseline behavior follows from them: it must fail on the baseline when it covers any change requirement, and pass when it covers only preserve requirements."
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "description": "Shell command that judges behavior or file contents. Never Git state, never the generated gate.sh."
        }
      },
      "additionalProperties": false
    },
    "contract": {
      "type": "object",
      "required": [
        "contract_id",
        "objective",
        "work_class",
        "risk",
        "read",
        "allowed_to_modify",
        "forbidden",
        "requirements",
        "verification",
        "response"
      ],
      "properties": {
        "contract_id": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "work_class": {
          "type": "string",
          "minLength": 1
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "read": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_to_modify": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "forbidden": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/requirement"
          }
        },
        "verification": {
          "type": "object",
          "required": [
            "checks",
            "invariants"
          ],
          "properties": {
            "checks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/check"
              }
            },
            "invariants": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "response": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
